// use prisma-8

enum EnrollmentStatus {
  @@type("pg/text@1")
  ACTIVE = "ACTIVE"
  COMPLETED = "COMPLETED"
  SUSPENDED = "SUSPENDED"
}

enum ProgressStatus {
  @@type("pg/text@1")
  LOCKED = "LOCKED"
  AVAILABLE = "AVAILABLE"
  IN_PROGRESS = "IN_PROGRESS"
  COMPLETED = "COMPLETED"
}

enum AttemptStatus {
  @@type("pg/text@1")
  IN_PROGRESS = "IN_PROGRESS"
  PASSED = "PASSED"
  FAILED = "FAILED"
}

enum GradedBy {
  @@type("pg/text@1")
  AUTO = "AUTO"
  SELF = "SELF"
}

enum PaymentStatus {
  @@type("pg/text@1")
  PENDING = "PENDING"
  PAID = "PAID"
  FAILED = "FAILED"
  REFUNDED = "REFUNDED"
}

model Enrollment {
  id             String           @id @default(cuid(2))
  clerkUserId    String
  sanityCourseId String
  status         EnrollmentStatus @default(ACTIVE)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  progressPercent Int  @default(0)
  finalScore      Int?

  lastLessonId   String?
  lastAccessedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  lessonProgress     LessonProgress[]
  taskAttempts       TaskAttempt[]
  assessmentAttempts AssessmentAttempt[]
  certificate        Certificate?

  @@unique([clerkUserId, sanityCourseId])
  @@index([clerkUserId])
  @@index([sanityCourseId])
}

model LessonProgress {
  id             String @id @default(cuid(2))
  enrollmentId   String
  sanityLessonId String

  status ProgressStatus @default(LOCKED)

  contentStartedAt   DateTime?
  contentCompletedAt DateTime?

  requiredTasksPassed Boolean @default(false)

  bestAssessmentScore Int?
  assessmentPassed    Boolean @default(false)

  lastSectionKey   String?
  lastViewedAt     DateTime?
  timeSpentSeconds Int       @default(0)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  sectionProgress    SectionProgress[]
  taskAttempts       TaskAttempt[]
  assessmentAttempts AssessmentAttempt[]

  @@unique([enrollmentId, sanityLessonId])
  @@index([enrollmentId])
  @@index([sanityLessonId])
}

model TaskAttempt {
  id               String @id @default(cuid(2))
  enrollmentId     String
  lessonProgressId String
  sanityTaskId     String
  sanitySectionKey String?

  attemptNumber Int           @default(1)
  status        AttemptStatus @default(IN_PROGRESS)
  gradedBy      GradedBy      @default(AUTO)

  submission   Json?
  rubricScores Json?
  score        Int?
  maxScore     Int?
  passed       Boolean @default(false)
  feedback     String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  lessonProgress LessonProgress @relation(fields: [lessonProgressId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, sanityTaskId])
  @@index([lessonProgressId])
}

model AssessmentAttempt {
  id               String  @id @default(cuid(2))
  enrollmentId     String
  lessonProgressId String?

  sanityAssessmentId String
  sanitySectionKey   String?

  attemptNumber Int           @default(1)
  status        AttemptStatus @default(IN_PROGRESS)

  score  Int?
  passed Boolean @default(false)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  lessonProgress LessonProgress? @relation(fields: [lessonProgressId], references: [id], onDelete: Cascade)

  responses AssessmentResponse[]

  @@index([enrollmentId, sanityAssessmentId])
  @@index([lessonProgressId])
}

model SectionProgress {
  id               String @id @default(cuid(2))
  lessonProgressId String
  sanitySectionKey String

  status      ProgressStatus @default(IN_PROGRESS)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  lessonProgress LessonProgress @relation(fields: [lessonProgressId], references: [id], onDelete: Cascade)

  @@unique([lessonProgressId, sanitySectionKey])
  @@index([lessonProgressId])
}

model AssessmentResponse {
  id                  String @id @default(cuid(2))
  assessmentAttemptId String
  sanityQuestionId    String

  response      Json?
  isCorrect     Boolean?
  pointsAwarded Int      @default(0)

  createdAt DateTime @default(now())

  assessmentAttempt AssessmentAttempt @relation(fields: [assessmentAttemptId], references: [id], onDelete: Cascade)

  @@unique([assessmentAttemptId, sanityQuestionId])
  @@index([sanityQuestionId])
}

model Certificate {
  id String @id @default(cuid(2))

  enrollmentId String @unique
  clerkUserId  String

  certificateNumber String @unique
  recipientName     String

  courseTitle    String
  completionDate DateTime

  certificatePrice Int    @default(500)
  currency         String @default("USD")

  paymentStatus    PaymentStatus @default(PENDING)
  paymentReference String?

  issuedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([clerkUserId])
  @@index([certificateNumber])
}

/// One row per learner, filled in by the onboarding questions. Plain columns (not JSON)
/// so distribution queries are simple GROUP BYs, e.g.
///   SELECT stage, COUNT(*) FROM "LearnerProfile" GROUP BY stage;
model LearnerProfile {
  id          String @id @default(cuid(2))
  clerkUserId String @unique

  /// school | college | professional | business | exploring
  stage String
  /// School form, study year, or years of experience (depends on stage)
  level String?
  /// Field of study or industry
  field String?
  /// Free text when field = "other"
  fieldOther String?
  /// new | tried | regular | advanced
  aiExperience String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([stage])
  @@index([stage, field])
}

/// A learner who registered interest in a course that is not live yet.
///   SELECT COUNT(*) FROM "CourseInterest" WHERE "sanityCourseId" = '...';
/// Join to "LearnerProfile" on clerkUserId to see who is waiting.
model CourseInterest {
  id             String @id @default(cuid(2))
  clerkUserId    String
  sanityCourseId String
  /// Email on the Clerk account when they registered
  email          String?

  /// Set when they tap the "Join WhatsApp group" button
  whatsappClickedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([clerkUserId, sanityCourseId])
  @@index([sanityCourseId])
}
